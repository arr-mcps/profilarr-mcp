# Base URL of your Profilarr instance (no trailing /api/v1)
PROFILARR_URL=https://profilarr.example.com

# API key - must match the X-Api-Key Profilarr accepts (PROFILARR_API_KEY env
# var on the server, or the key generated under Settings > Security)
PROFILARR_API_KEY=

# Optional: where profilarr_download_backup writes archives
# PROFILARR_TEMP_DIR=/tmp